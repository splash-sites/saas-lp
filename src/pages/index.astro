---
import Base from "../layouts/Base.astro";
import Painel from "../components/mock/Painel.astro";
import Agenda from "../components/mock/Agenda.astro";
import Prontuario from "../components/mock/Prontuario.astro";
import Financeiro from "../components/mock/Financeiro.astro";
import Lembretes from "../components/mock/Lembretes.astro";
import Pacientes from "../components/mock/Pacientes.astro";
import "../styles/mock.css";
import { APP_LOGIN_URL, CTA_TEXTO, CICLOS, SITE_URL, WHATSAPP_URL } from "../consts";

const title = "Gradatim — sistema para consultório de psicologia";
const description =
  "Agenda, prontuário, financeiro, atendimento online e lembretes num painel só, para quem atende por conta própria. Preço único, tudo incluído. 14 dias grátis, sem cartão.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Gradatim",
  url: SITE_URL,
  description,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  inLanguage: "pt-BR",
  offers: CICLOS.map((c) => ({
    "@type": "Offer",
    name: `Plano ${c.nome.toLowerCase()}`,
    price: c.cobranca.match(/R\$ ([\d.,]+)/)![1].replace(".", "").replace(",", "."),
    priceCurrency: "BRL",
  })),
};

const mensagens = [
  {
    msg: "Oi! Desculpa, esqueci totalmente da sessão de hoje.",
    titulo: "Lembrete na véspera, em um clique",
    texto: "A mensagem sai pronta do seu WhatsApp, sem custo por envio.",
  },
  {
    msg: "Pode me mandar o link da chamada de novo?",
    titulo: "Link do Meet criado com a consulta",
    texto: "Fica na agenda, pronto para copiar.",
  },
  {
    msg: "Acho que já te paguei o mês passado, não?",
    titulo: "Pago, pendente ou atrasado",
    texto: "Cada sessão lançada, sem procurar na planilha.",
  },
];

const pontos = {
  agenda: [
    "Online ou presencial",
    "Repetição semanal ou quinzenal",
    "Horários bloqueados",
    "Falta e confirmação com um toque",
  ],
  prontuario: [
    "Ficha e anamnese com demanda e objetivos",
    "Notas privadas separadas da evolução",
    "Aviso de evoluções pendentes",
    "Prontuário em PDF",
  ],
  financeiro: ["Pago, pendente ou atrasado", "Ganhos do mês", "Histórico mês a mês"],
  lembretes: ["Mensagem editável", "Sai do seu número", "Convite por e-mail para quem autorizou"],
};

const seguranca = [
  {
    titulo: "Pensado para a Resolução CFP 01/2009",
    texto: "Campos de evolução que a resolução pede e guarda mínima de 5 anos. Arquivar não apaga.",
  },
  {
    titulo: "Dados tratados conforme a LGPD",
    texto: "Cada conta isolada, criptografia em repouso, acesso só seu.",
  },
  {
    titulo: "Somente leitura, nunca bloqueio",
    texto: "Se a assinatura vencer, você continua vendo e exportando tudo.",
  },
  {
    titulo: "Seus dados saem com você",
    texto: "Prontuário em PDF por paciente e a conta inteira em planilhas, quando quiser.",
  },
];

const faq = [
  {
    p: "Preciso de cartão para testar?",
    r: "Não. Os 14 dias grátis começam no cadastro e nada é pedido para pagamento. Se decidir continuar, você escolhe o ciclo e paga por Pix, boleto ou cartão.",
  },
  {
    p: "E se a assinatura vencer?",
    r: "A conta fica em somente leitura. Você vê e exporta tudo e só não cadastra nada novo até regularizar.",
  },
  {
    p: "Posso cancelar quando quiser?",
    r: "Sim, a qualquer momento, pela própria plataforma e sem multa. Antes de sair, você exporta o prontuário em PDF e a conta inteira em planilhas.",
  },
  {
    p: "Funciona no celular?",
    r: "Sim, pelo navegador do celular, tablet ou computador. Não é app de loja, então não há nada para instalar.",
  },
  {
    p: "O paciente precisa instalar algo?",
    r: "Não. Ele recebe o lembrete no WhatsApp, enviado do seu número com um clique seu, e, se autorizou, o convite da consulta por e-mail.",
  },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <!-- Topo -->
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="wrap hero-texto">
      <h1 id="hero-titulo">Menos burocracia entre uma sessão e outra.</h1>
      <p class="lede hero-lede">
        Agenda, prontuário, financeiro e lembretes no celular ou no computador, para quem atende
        por conta própria. Um preço, tudo incluído.
      </p>
      <div class="hero-cta">
        <a href={APP_LOGIN_URL} class="btn btn-primary">{CTA_TEXTO}</a>
        <span class="nota">Sem cartão no cadastro</span>
      </div>
    </div>

    <div class="wrap">
      <div class="celulares" role="img" aria-label="Telas do Gradatim no celular, com dados fictícios: prontuário, agenda do dia e lembretes de amanhã.">
        <div class="celular celular-lado celular-esq" aria-hidden="true">
          <div class="tela">
            <b class="tela-titulo">Prontuário</b>
            <span class="tela-sub">Sessão 14 · 12 out</span>
            <div class="campo"><b>Demanda e objetivo</b><span data-sensivel>Ansiedade no trabalho</span></div>
            <div class="campo"><b>O que foi trabalhado</b><span data-sensivel>Ensaio da reunião</span></div>
            <div class="campo"><b>Resultados</b><span data-sensivel>Menos tensão</span></div>
            <div class="campo"><b>Encaminhamentos</b><span data-sensivel>Manter registro</span></div>
          </div>
        </div>

        <div class="celular celular-meio" aria-hidden="true">
          <div class="tela">
            <b class="tela-titulo tela-titulo-g">Hoje</b>
            <span class="tela-sub tela-sub-cola">Terça, 13 de outubro</span>
            <div class="slot"><span>08:00</span><div class="ev presencial"><b data-sensivel>Joana M.</b><span>Presencial · confirmou</span></div></div>
            <div class="slot"><span>10:00</span><div class="ev online"><b data-sensivel>Caio F.</b><span>Online · Meet</span></div></div>
            <div class="slot"><span>12:00</span><div class="ev bloqueio"><b>Almoço</b><span>Bloqueado</span></div></div>
            <div class="slot"><span>15:00</span><div class="ev online"><b data-sensivel>Renata A.</b><span>Online · quinzenal</span></div></div>
            <div class="slot"><span>17:00</span><div class="ev presencial"><b data-sensivel>Igor D.</b><span>Presencial · semanal</span></div></div>
          </div>
        </div>

        <div class="celular celular-lado celular-dir" aria-hidden="true">
          <div class="tela">
            <b class="tela-titulo">Lembretes</b>
            <span class="tela-sub">Consultas de amanhã</span>
            <div class="lem"><b data-sensivel>Marcos V.</b><span class="tela-sub">Enviado</span></div>
            <div class="lem"><b data-sensivel>Helena P.</b><span class="wa">WhatsApp</span></div>
            <div class="lem"><b data-sensivel>Joana M.</b><span class="wa">WhatsApp</span></div>
            <div class="bolha">Olá, <span data-sensivel>Helena</span>! Lembrete da sua consulta amanhã às 13h. Até lá!</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Dores como mensagens -->
  <section class="faixa" aria-labelledby="dores-titulo">
    <div class="wrap bloco">
      <div class="cabeca">
        <h2 id="dores-titulo">Mensagens que você já recebeu.</h2>
        <p class="lede">E o que muda quando o consultório está organizado num lugar só.</p>
      </div>
      <div class="chat">
        {
          mensagens.map((m) => (
            <>
              <p class="msg">{m.msg}</p>
              <div class="resposta">
                <b>{m.titulo}</b>
                <span>{m.texto}</span>
              </div>
            </>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Painel: o dia numa tela -->
  <section id="recursos" class="secao" aria-labelledby="painel-titulo">
    <div class="wrap bloco">
      <div class="cabeca">
        <h2 id="painel-titulo">Abriu o sistema, o dia está ali.</h2>
        <p class="lede">
          Quem você atende hoje, o que ficou sem evolução, quem precisa de lembrete e quanto entrou
          no mês. Tudo na primeira tela.
        </p>
      </div>
      <div>
        <div class="m-rolagem"><Painel /></div>
        <p class="m-arraste" aria-hidden="true">Arraste a tela para o lado →</p>
      </div>
    </div>
  </section>

  <!-- Agenda -->
  <section class="faixa" aria-labelledby="agenda-titulo">
    <div class="wrap bloco">
      <div class="cabeca">
        <h2 id="agenda-titulo">A semana inteira, com o link do Meet pronto.</h2>
        <p class="lede">
          Semana no computador, o dia de hoje no celular. Marcou a consulta como online, o link do
          Google Meet está criado, e ela aparece sozinha no seu Google Agenda.
        </p>
        <ul class="pontos">{pontos.agenda.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div>
        <div class="m-rolagem"><Agenda /></div>
        <p class="m-arraste" aria-hidden="true">Arraste a tela para o lado →</p>
      </div>
    </div>
  </section>

  <!-- Prontuário -->
  <section class="secao" aria-labelledby="prontuario-titulo">
    <div class="wrap bloco">
      <div class="cabeca">
        <h2 id="prontuario-titulo">O registro que a CFP pede, sessão a sessão.</h2>
        <p class="lede">
          A evolução tem os campos pensados para a Resolução CFP 01/2009, então o registro sai
          completo. Cada paciente tem a sua linha do tempo, e arquivar não apaga.
        </p>
        <ul class="pontos">{pontos.prontuario.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div>
        <div class="m-rolagem"><Prontuario /></div>
        <p class="m-arraste" aria-hidden="true">Arraste a tela para o lado →</p>
      </div>
    </div>
  </section>

  <!-- Financeiro -->
  <section class="faixa" aria-labelledby="financeiro-titulo">
    <div class="wrap bloco">
      <div class="cabeca">
        <h2 id="financeiro-titulo">Quem pagou, quem falta e quanto entrou.</h2>
        <p class="lede">
          Lance o pagamento da sessão em segundos. O mês fecha sozinho, com histórico para comparar
          com os anteriores.
        </p>
        <ul class="pontos">{pontos.financeiro.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div>
        <div class="m-rolagem"><Financeiro /></div>
        <p class="m-arraste" aria-hidden="true">Arraste a tela para o lado →</p>
      </div>
    </div>
  </section>

  <!-- Lembretes -->
  <section class="secao" aria-labelledby="lembretes-titulo">
    <div class="wrap bloco">
      <div class="cabeca">
        <h2 id="lembretes-titulo">Um clique e o lembrete já está escrito.</h2>
        <p class="lede">
          A lista das consultas de amanhã abre o WhatsApp com a mensagem pronta, saindo do seu
          número. Sem custo por mensagem e sem nenhum dado clínico.
        </p>
        <ul class="pontos">{pontos.lembretes.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div>
        <div class="m-rolagem"><Lembretes /></div>
        <p class="m-arraste" aria-hidden="true">Arraste a tela para o lado →</p>
      </div>
    </div>
  </section>

  <!-- Segurança + Google Agenda -->
  <section id="seguranca" class="faixa" aria-labelledby="seg-titulo">
    <div class="wrap">
      <div class="claro">
        <div class="cabeca">
          <h2 id="seg-titulo">O sigilo vem antes de qualquer função.</h2>
          <p class="claro-lede">Prontuário é obrigação ética e dado sensível. O Gradatim trata como tal.</p>
        </div>
        <ul class="seg">
          {
            seguranca.map((s) => (
              <li>
                <h3>{s.titulo}</h3>
                <p>{s.texto}</p>
              </li>
            ))
          }
        </ul>
        <div id="google-agenda" class="google">
          <h3>Como o Gradatim usa o seu Google Agenda</h3>
          <p>
            Ao conectar sua conta Google, você autoriza o Gradatim a criar, atualizar e cancelar na
            sua agenda os eventos das consultas marcadas aqui. Nas consultas online, o mesmo evento
            gera o link do Google Meet. Não lemos nem importamos seus outros eventos: a via é de
            mão única, do Gradatim para o Google. Se o paciente autorizou lembretes e tem e-mail
            cadastrado, ele recebe o convite do evento. A conexão é opcional e pode ser desfeita a
            qualquer momento. Detalhes na <a href="/privacidade">Política de Privacidade</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Modo privado -->
  <section class="secao" aria-labelledby="privado-titulo">
    <div class="wrap bloco">
      <div class="privado-topo">
        <div class="cabeca">
          <h2 id="privado-titulo">Vai compartilhar a tela? Alt+O.</h2>
          <p class="lede">
            Em supervisão, aula ou suporte, o modo privado borra nomes, telefones e valores. Aperte
            de novo e tudo volta. Experimente aqui.
          </p>
        </div>
        <button type="button" class="btn btn-privado" id="btn-privado" aria-pressed="false">
          <kbd>Alt+O</kbd><span id="btn-privado-texto">Ligar modo privado</span>
        </button>
      </div>
      <div>
        <div class="m-rolagem"><Pacientes /></div>
        <p class="m-arraste" aria-hidden="true">Arraste a tela para o lado →</p>
      </div>
    </div>
  </section>

  <!-- Preço -->
  <section id="preco" class="faixa" aria-labelledby="preco-titulo">
    <div class="wrap preco">
      <div class="cabeca">
        <h2 id="preco-titulo">Um preço só. O lembrete já vem dentro.</h2>
        <p class="lede">
          Sem plano básico, sem add-on e sem cobrança por mensagem. Quanto maior o ciclo, menor o
          valor por mês.
        </p>
        <ul class="condicoes">
          <li>14 dias grátis, sem cartão</li>
          <li>Pix, boleto ou cartão</li>
          <li>Cancele quando quiser, sem multa</li>
        </ul>
      </div>

      <div class="plano">
        <fieldset class="ciclos">
          <legend class="sr-only">Ciclo de cobrança</legend>
          {
            CICLOS.map((c, i) => (
              <label class="ciclo">
                <input
                  type="radio"
                  name="ciclo"
                  value={c.id}
                  checked={i === 0}
                  data-por-mes={c.porMes}
                  data-cobranca={c.cobranca}
                />
                <span>
                  {c.nome}
                  {c.desconto && <small>{c.desconto}</small>}
                </span>
              </label>
            ))
          }
        </fieldset>
        <p class="valor" aria-live="polite">
          <span class="valor-moeda">R$</span>
          <span class="valor-num" id="plano-num">{CICLOS[0].porMes}</span>
          <span class="valor-mes">/mês</span>
        </p>
        <p class="cobranca" id="plano-cobranca">{CICLOS[0].cobranca}</p>
        <a href={APP_LOGIN_URL} class="btn btn-primary">{CTA_TEXTO}</a>
      </div>
    </div>
  </section>

  <!-- Dúvidas -->
  <section id="duvidas" class="secao" aria-labelledby="duvidas-titulo">
    <div class="wrap duvidas">
      <h2 id="duvidas-titulo">Dúvidas frequentes</h2>
      <div class="faq">
        {
          faq.map((item) => (
            <details>
              <summary>{item.p}</summary>
              <p>{item.r}</p>
            </details>
          ))
        }
      </div>
      <p class="faq-contato">
        Não achou sua resposta?
        <a href={WHATSAPP_URL} rel="noopener" target="_blank">Fale com a gente pelo WhatsApp</a>.
      </p>
    </div>
  </section>

  <!-- Chamado final -->
  <section class="final" aria-labelledby="final-titulo">
    <div class="wrap final-inner">
      <h2 id="final-titulo" class="final-titulo">A próxima sessão começa mais leve.</h2>
      <p class="lede">Gradatim é latim para "passo a passo". Comece pelo primeiro.</p>
      <a href={APP_LOGIN_URL} class="btn btn-primary">{CTA_TEXTO}</a>
    </div>
  </section>
</Base>

<script>
  // Seletor de ciclo de cobrança.
  const plano = document.querySelector<HTMLElement>(".plano");
  const num = document.getElementById("plano-num");
  const cobranca = document.getElementById("plano-cobranca");
  plano?.addEventListener("change", (e) => {
    const input = e.target as HTMLInputElement;
    if (input.name !== "ciclo" || !num || !cobranca) return;
    num.textContent = input.dataset.porMes ?? "";
    cobranca.textContent = input.dataset.cobranca ?? "";
  });

  // Botão de teste do modo privado, sincronizado com Alt+O.
  const botao = document.getElementById("btn-privado");
  const sincronizar = () => {
    const ligado = document.documentElement.hasAttribute("data-privado");
    botao?.setAttribute("aria-pressed", String(ligado));
    const texto = document.getElementById("btn-privado-texto");
    if (texto) texto.textContent = ligado ? "Desligar modo privado" : "Ligar modo privado";
  };
  botao?.addEventListener("click", () => {
    document.documentElement.toggleAttribute("data-privado");
    sincronizar();
  });
  document.addEventListener("privado", sincronizar);
</script>

<style>
  .secao {
    padding-block: var(--section);
  }
  .faixa {
    background: var(--ink-deep);
    padding-block: var(--section);
  }
  .bloco {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }
  .cabeca {
    display: grid;
    gap: 0.9rem;
    max-width: 40rem;
    align-content: start;
  }
  .titulo-largo {
    max-width: 45rem;
  }

  /* Topo */
  .hero {
    padding-top: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    padding-bottom: var(--section);
    overflow: hidden;
  }
  .hero-texto {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.5rem;
  }
  .hero-texto h1 {
    max-width: 14ch;
  }
  .hero-lede {
    max-width: 39rem;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .nota {
    font-size: 0.95rem;
    color: var(--text-soft);
  }

  /* Celulares */
  .celulares {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    margin-top: clamp(2.5rem, 2rem + 3vw, 4rem);
  }
  .celular {
    flex: none;
    background: var(--ink-raise);
    border-radius: 44px;
    padding: 10px;
    box-shadow: 0 50px 100px -30px rgb(0 0 0 / 0.7);
  }
  .celular-meio {
    width: 280px;
    position: relative;
    z-index: 2;
  }
  .celular-lado {
    width: 250px;
    border-radius: 40px;
    margin-top: 56px;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.6);
  }
  .celular-esq {
    transform: rotate(-7deg) translateX(30px);
  }
  .celular-dir {
    transform: rotate(7deg) translateX(-30px);
  }
  .tela {
    background: var(--paper);
    color: var(--ink-on-paper);
    border-radius: 34px;
    padding: 28px 16px 20px;
    height: 470px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 13px;
    line-height: 1.35;
    text-align: left;
  }
  .celular-meio .tela {
    height: 540px;
    padding-top: 30px;
  }
  .tela-titulo {
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  .tela-titulo-g {
    font-size: 22px;
  }
  .tela-sub {
    color: var(--soft-on-paper);
  }
  .tela-sub-cola {
    margin-top: -6px;
  }
  .campo,
  .lem,
  .ev {
    background: #fff;
    border-radius: 14px;
    padding: 10px;
  }
  .campo b {
    display: block;
    font-size: 11px;
    color: var(--teal);
  }
  .slot {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 8px;
    align-items: center;
  }
  .slot > span {
    color: var(--soft-on-paper);
  }
  .ev {
    display: grid;
    border-left: 4px solid transparent;
  }
  .ev span {
    color: var(--soft-on-paper);
  }
  .ev.presencial {
    border-left-color: var(--marigold);
  }
  .ev.online {
    border-left-color: var(--teal);
  }
  .ev.bloqueio {
    background: var(--mist);
  }
  .lem {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .wa {
    background: var(--whatsapp);
    color: #fff;
    border-radius: 999px;
    padding: 3px 10px;
    font-weight: 700;
  }
  .bolha {
    background: var(--mist);
    border-radius: 14px 14px 14px 4px;
    padding: 10px;
    margin-top: 6px;
  }
  @media (max-width: 60rem) {
    .celular-lado {
      display: none;
    }
  }

  /* Dores */
  .chat {
    display: grid;
    gap: 1.25rem 3rem;
    align-items: center;
  }
  @media (min-width: 48rem) {
    .chat {
      grid-template-columns: 1fr 1fr;
    }
  }
  .msg {
    justify-self: start;
    background: var(--ink-raise);
    border-radius: 22px 22px 22px 6px;
    padding: 1rem 1.25rem;
    font-size: 1.125rem;
    max-width: 29rem;
  }
  .resposta {
    display: grid;
    gap: 0.25rem;
  }
  .resposta b {
    color: var(--marigold);
  }
  .resposta span {
    color: var(--text-soft);
  }
  @media (max-width: 47.99rem) {
    .resposta {
      padding-left: 1rem;
      margin-bottom: 1rem;
    }
  }

  /* Seções com tela da aplicação */
  .pontos {
