---
import Base from "../layouts/Base.astro";
import { Picture } from "astro:assets";
import Navegador from "../components/Navegador.astro";
import Celular from "../components/Celular.astro";
import imgPainel from "../assets/prints/painel.png";
import imgAgenda from "../assets/prints/agenda.png";
import imgAgendaConsulta from "../assets/prints/agenda-consulta.png";
import imgAgendaCelular from "../assets/prints/agenda-celular.png";
import imgProntuario from "../assets/prints/prontuario.png";
import imgFinanceiro from "../assets/prints/financeiro.png";
import imgLembretes from "../assets/prints/lembretes.png";
import imgPacientes from "../assets/prints/pacientes.png";
import imgPacientesPrivado from "../assets/prints/pacientes-privado.png";
import { APP_LOGIN_URL, CTA_TEXTO, CICLOS, SITE_URL, WHATSAPP_URL } from "../consts";

const title = "Gradatim — sistema para consultório de psicologia";
const description =
  "Agenda, prontuário, financeiro, atendimento online e lembretes num painel só, para quem atende por conta própria. Preço único, tudo incluído. 14 dias grátis, sem cartão.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Gradatim",
  url: SITE_URL,
  description,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  inLanguage: "pt-BR",
  offers: CICLOS.map((c) => ({
    "@type": "Offer",
    name: `Plano ${c.nome.toLowerCase()}`,
    price: c.cobranca.match(/R\$ ([\d.,]+)/)![1].replace(".", "").replace(",", "."),
    priceCurrency: "BRL",
  })),
};

const mensagens = [
  {
    msg: "Oi! Desculpa, esqueci totalmente da sessão de hoje.",
    titulo: "Lembrete na véspera, em um clique",
    texto: "A mensagem sai pronta do seu WhatsApp, sem custo por envio.",
  },
  {
    msg: "Pode me mandar o link da chamada de novo?",
    titulo: "Link do Meet criado com a consulta",
    texto: "Fica na agenda, pronto para copiar.",
  },
  {
    msg: "Acho que já te paguei o mês passado, não?",
    titulo: "Pago, pendente ou atrasado",
    texto: "Cada sessão lançada, sem procurar na planilha.",
  },
];

const pontos = {
  agenda: [
    "Online ou presencial",
    "Repetição semanal ou quinzenal",
    "Horários bloqueados",
    "Confirmada, a confirmar ou falta",
  ],
  prontuario: [
    "Ficha e anamnese com demanda e objetivos",
    "Notas privadas separadas da evolução",
    "Aviso de evoluções pendentes no painel",
    "Prontuário em PDF",
  ],
  financeiro: ["Pago, pendente ou atrasado", "Marcar como pago com um clique", "Histórico mês a mês"],
  lembretes: ["Mostra o que já foi enviado", "Mensagem editável", "Sem nenhum dado clínico"],
};

const seguranca = [
  {
    titulo: "Pensado para a Resolução CFP 01/2009",
    texto: "Campos de evolução que a resolução pede e guarda mínima de 5 anos. Arquivar não apaga.",
  },
  {
    titulo: "Dados tratados conforme a LGPD",
    texto: "Cada conta isolada, criptografia em repouso, acesso só seu.",
  },
  {
    titulo: "Somente leitura, nunca bloqueio",
    texto: "Se a assinatura vencer, você continua vendo e exportando tudo.",
  },
  {
    titulo: "Seus dados saem com você",
    texto: "Prontuário em PDF por paciente e a conta inteira em planilhas, quando quiser.",
  },
];

const faq = [
  {
    p: "Preciso de cartão para testar?",
    r: "Não. Os 14 dias grátis começam no cadastro e nada é pedido para pagamento. Se decidir continuar, você escolhe o ciclo e paga por Pix, boleto ou cartão.",
  },
  {
    p: "E se a assinatura vencer?",
    r: "A conta fica em somente leitura. Você vê e exporta tudo e só não cadastra nada novo até regularizar.",
  },
  {
    p: "Posso cancelar quando quiser?",
    r: "Sim, a qualquer momento, pela própria plataforma e sem multa. Antes de sair, você exporta o prontuário em PDF e a conta inteira em planilhas.",
  },
  {
    p: "Funciona no celular?",
    r: "Sim, pelo navegador do celular, tablet ou computador. Não é app de loja, então não há nada para instalar.",
  },
  {
    p: "O paciente precisa instalar algo?",
    r: "Não. Ele recebe o lembrete no WhatsApp, enviado do seu número com um clique seu, e, se autorizou, o convite da consulta por e-mail.",
  },
];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <!-- Topo -->
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="wrap hero-texto">
      <h1 id="hero-titulo">Menos burocracia entre uma sessão e outra.</h1>
      <p class="lede hero-lede">
        Agenda, prontuário, financeiro e lembretes no celular ou no computador, para quem atende
        por conta própria. Um preço, tudo incluído.
      </p>
      <div class="hero-cta">
        <a href={APP_LOGIN_URL} class="btn btn-primary">{CTA_TEXTO}</a>
        <span class="nota">Sem cartão no cadastro</span>
      </div>
    </div>

    <div class="wrap hero-visual">
      <Navegador url="app.gradatim.com.br/dashboard" class="hero-janela">
        <Picture
          src={imgPainel}
          formats={["avif", "webp"]}
          widths={[800, 1200, 1600, 2060]}
          sizes="(min-width: 75rem) 64rem, 88vw"
          alt="Painel do Gradatim: saudação, 5 consultas hoje, 2 evoluções pendentes com o aviso de que o registro é obrigatório pela CFP 01/2009, 3 lembretes a enviar, R$ 9.780 recebidos no mês e a lista de consultas de hoje e dos próximos dias. Dados fictícios."
          loading="eager"
          fetchpriority="high"
        />
      </Navegador>
      <Celular class="hero-celular">
        <Picture
          src={imgAgendaCelular}
          formats={["avif", "webp"]}
          widths={[390, 780]}
          sizes="15rem"
          alt="Agenda do dia no celular, com as consultas de quarta-feira, o almoço bloqueado e o botão Entrar no Meet numa consulta online. Dados fictícios."
          loading="eager"
        />
      </Celular>
    </div>
  </section>

  <!-- Dores como mensagens -->
  <section class="faixa" aria-labelledby="dores-titulo">
    <div class="wrap bloco">
      <div class="cabeca">
        <h2 id="dores-titulo">Mensagens que você já recebeu.</h2>
        <p class="lede">E o que muda quando o consultório está organizado num lugar só.</p>
      </div>
      <div class="chat">
        {
          mensagens.map((m) => (
            <>
              <p class="msg">{m.msg}</p>
              <div class="resposta">
                <b>{m.titulo}</b>
                <span>{m.texto}</span>
              </div>
            </>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Agenda -->
  <section id="recursos" class="secao" aria-labelledby="agenda-titulo">
    <div class="wrap bloco">
      <div class="cabeca">
        <h2 id="agenda-titulo">A semana inteira, com o link do Meet pronto.</h2>
        <p class="lede">
          Semana no computador, o dia de hoje no celular. Marcou a consulta como online, o link do
          Google Meet aparece nela, pronto para copiar, e tudo vai sozinho para o seu Google Agenda.
        </p>
        <ul class="pontos">{pontos.agenda.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div class="agenda-visual">
        <div class="agenda-rolagem">
          <Navegador url="app.gradatim.com.br/agenda">
            <Picture
              src={imgAgenda}
              formats={["avif", "webp"]}
              widths={[800, 1200, 1600, 2060]}
              sizes="(min-width: 75rem) 71rem, 92vw"
              alt="Agenda semanal do Gradatim de 12 a 18 de outubro com 23 consultas, online e presenciais, marcadas como realizada, confirmada, a confirmar e uma falta, e o almoço bloqueado todos os dias das 12h às 13h. Dados fictícios."
              loading="lazy"
            />
          </Navegador>
        </div>
        <p class="arraste" aria-hidden="true">Arraste a agenda para o lado →</p>
        <Navegador url="app.gradatim.com.br/agenda/consulta" class="agenda-detalhe">
          <Picture
            src={imgAgendaConsulta}
            formats={["avif", "webp"]}
            widths={[500, 900, 1400]}
            sizes="(min-width: 56rem) 36rem, 92vw"
            alt="Videochamada de uma consulta online, com o link do Google Meet, o botão Copiar link e o aviso Sincronizada com o Google. Dados fictícios."
            loading="lazy"
          />
        </Navegador>
      </div>
    </div>
  </section>

  <!-- Prontuário -->
  <section class="faixa" aria-labelledby="prontuario-titulo">
    <div class="wrap lado">
      <div class="cabeca">
        <h2 id="prontuario-titulo">O registro que a CFP pede, sessão a sessão.</h2>
        <p class="lede">
          A evolução tem os campos pensados para a Resolução CFP 01/2009, então o registro sai
          completo. Cada paciente tem a sua linha do tempo, e arquivar não apaga.
        </p>
        <ul class="lista-check">{pontos.prontuario.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div class="lado-visual">
        <Navegador url="app.gradatim.com.br/pacientes/evolucoes">
          <Picture
            src={imgProntuario}
            formats={["avif", "webp"]}
            widths={[600, 900, 1300]}
            sizes="(min-width: 56rem) 34rem, 92vw"
            alt="Evolução da sessão de 12 de outubro com os quatro campos: avaliação da demanda e objetivos, procedimentos aplicados, resultados obtidos e encaminhamentos e decisões. Dados fictícios."
            loading="lazy"
          />
        </Navegador>
      </div>
    </div>
  </section>

  <!-- Financeiro -->
  <section class="secao" aria-labelledby="financeiro-titulo">
    <div class="wrap lado lado-invertido">
      <div class="cabeca">
        <h2 id="financeiro-titulo">Quem pagou, quem falta e quanto entrou.</h2>
        <p class="lede">
          Lance o pagamento da sessão em segundos e marque como pago quando receber. O mês mostra
          o recebido, o que falta receber e o que está atrasado, com histórico mês a mês.
        </p>
        <ul class="lista-check">{pontos.financeiro.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div class="lado-visual">
        <Navegador url="app.gradatim.com.br/financeiro">
          <Picture
            src={imgFinanceiro}
            formats={["avif", "webp"]}
            widths={[600, 900, 1300]}
            sizes="(min-width: 56rem) 30rem, 92vw"
            alt="Financeiro de outubro: R$ 9.780 recebidos, R$ 6.440 a receber e 1 atrasado, com a lista de lançamentos por paciente marcados como pago, atrasado e pendente. Dados fictícios."
            loading="lazy"
          />
        </Navegador>
      </div>
    </div>
  </section>

  <!-- Lembretes -->
  <section class="faixa" aria-labelledby="lembretes-titulo">
    <div class="wrap lado">
      <div class="cabeca">
        <h2 id="lembretes-titulo">Um clique e o lembrete já está escrito.</h2>
        <p class="lede">
          Todo dia o Gradatim lista as consultas de amanhã. O botão "Enviar no WhatsApp" abre a
          conversa com a mensagem pronta, saindo do seu número. Quem autorizou também recebe o
          convite por e-mail pelo Google Agenda. Sem custo por mensagem.
        </p>
        <ul class="lista-check">{pontos.lembretes.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div class="lado-visual">
        <Navegador url="app.gradatim.com.br/lembretes">
          <Picture
            src={imgLembretes}
            formats={["avif", "webp"]}
            widths={[600, 900, 1300]}
            sizes="(min-width: 56rem) 34rem, 92vw"
            alt="Lembretes de quinta-feira, 15 de outubro: 4 consultas e 3 lembretes a enviar, com o botão Enviar no WhatsApp em cada uma e um lembrete já enviado às 15:30. Dados fictícios."
            loading="lazy"
          />
        </Navegador>
      </div>
    </div>
  </section>

  <!-- Segurança + Google Agenda -->
  <section id="seguranca" class="secao" aria-labelledby="seg-titulo">
    <div class="wrap">
      <div class="claro">
        <div class="cabeca">
          <h2 id="seg-titulo">O sigilo vem antes de qualquer função.</h2>
          <p class="claro-lede">Prontuário é obrigação ética e dado sensível. O Gradatim trata como tal.</p>
        </div>
        <ul class="seg">
          {
            seguranca.map((s) => (
              <li>
                <h3>{s.titulo}</h3>
                <p>{s.texto}</p>
              </li>
            ))
          }
        </ul>
        <div id="google-agenda" class="google">
          <h3>Como o Gradatim usa o seu Google Agenda</h3>
          <p>
            Ao conectar sua conta Google, você autoriza o Gradatim a criar, atualizar e cancelar na
            sua agenda os eventos das consultas marcadas aqui. Nas consultas online, o mesmo evento
            gera o link do Google Meet. Não lemos nem importamos seus outros eventos: a via é de
            mão única, do Gradatim para o Google. Se o paciente autorizou lembretes e tem e-mail
            cadastrado, ele recebe o convite do evento. A conexão é opcional e pode ser desfeita a
            qualquer momento. Detalhes na <a href="/privacidade">Política de Privacidade</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Modo privado -->
  <section class="faixa" aria-labelledby="privado-titulo">
    <div class="wrap lado lado-invertido">
      <div class="cabeca">
        <h2 id="privado-titulo">Vai compartilhar a tela? Alt+O.</h2>
        <p class="lede">
          Em supervisão, aula ou suporte, o modo privado borra nomes, telefones e valores. Aperte de
          novo e tudo volta. Experimente aqui.
        </p>
        <button type="button" class="btn btn-privado" id="btn-privado" aria-pressed="false">
          <kbd>Alt+O</kbd><span id="btn-privado-texto">Ligar modo privado</span>
        </button>
      </div>
      <div class="lado-visual">
        <Navegador url="app.gradatim.com.br/pacientes">
          <div class="privado-imagens">
            <Picture
              src={imgPacientes}
              formats={["avif", "webp"]}
              widths={[600, 900, 1300]}
              sizes="(min-width: 56rem) 34rem, 92vw"
              alt="Lista de pacientes com nome, status ativo ou inativo e telefone. Dados fictícios."
              loading="lazy"
            />
            <Picture
              src={imgPacientesPrivado}
              formats={["avif", "webp"]}
              widths={[600, 900, 1300]}
              sizes="(min-width: 56rem) 34rem, 92vw"
              alt="A mesma lista de pacientes com o modo privado ligado: nomes e telefones borrados, só o status visível."
              loading="lazy"
              class="privado-borrado"
            />
          </div>
        </Navegador>
      </div>
    </div>
  </section>

  <!-- Preço -->
  <section id="preco" class="secao" aria-labelledby="preco-titulo">
    <div class="wrap preco">
      <div class="cabeca">
        <h2 id="preco-titulo">Um preço só. O lembrete já vem dentro.</h2>
        <p class="lede">
          Sem plano básico, sem add-on e sem cobrança por mensagem. Quanto maior o ciclo, menor o
          valor por mês.
        </p>
        <ul class="condicoes">
          <li>14 dias grátis, sem cartão</li>
          <li>Pix, boleto ou cartão</li>
          <li>Cancele quando quiser, sem multa</li>
        </ul>
      </div>

      <div class="plano">
        <fieldset class="ciclos">
          <legend class="sr-only">Ciclo de cobrança</legend>
          {
            CICLOS.map((c, i) => (
              <label class="ciclo">
                <input
                  type="radio"
                  name="ciclo"
                  value={c.id}
                  checked={i === 0}
                  data-por-mes={c.porMes}
                  data-cobranca={c.cobranca}
                />
                <span>
                  {c.nome}
                  {c.desconto && <small>{c.desconto}</small>}
                </span>
              </label>
            ))
          }
        </fieldset>
        <p class="valor" aria-live="polite">
          <span class="valor-moeda">R$</span>
          <span class="valor-num" id="plano-num">{CICLOS[0].porMes}</span>
          <span class="valor-mes">/mês</span>
        </p>
        <p class="cobranca" id="plano-cobranca">{CICLOS[0].cobranca}</p>
        <a href={APP_LOGIN_URL} class="btn btn-primary">{CTA_TEXTO}</a>
      </div>
    </div>
  </section>

  <!-- Dúvidas -->
  <section id="duvidas" class="faixa" aria-labelledby="duvidas-titulo">
    <div class="wrap duvidas">
      <h2 id="duvidas-titulo">Dúvidas frequentes</h2>
      <div class="faq">
        {
          faq.map((item) => (
            <details>
              <summary>{item.p}</summary>
              <p>{item.r}</p>
            </details>
          ))
        }
      </div>
      <p class="faq-contato">
        Não achou sua resposta?
        <a href={WHATSAPP_URL} rel="noopener" target="_blank">Fale com a gente pelo WhatsApp</a>.
      </p>
    </div>
  </section>

  <!-- Chamado final -->
  <section class="final" aria-labelledby="final-titulo">
    <div class="wrap final-inner">
      <h2 id="final-titulo" class="final-titulo">A próxima sessão começa mais leve.</h2>
      <p class="lede">Gradatim é latim para "passo a passo". Comece pelo primeiro.</p>
      <a href={APP_LOGIN_URL} class="btn btn-primary">{CTA_TEXTO}</a>
    </div>
  </section>
</Base>

<script>
  // Seletor de ciclo de cobrança.
  const plano = document.querySelector<HTMLElement>(".plano");
  const num = document.getElementById("plano-num");
  const cobranca = document.getElementById("plano-cobranca");
  plano?.addEventListener("change", (e) => {
    const input = e.target as HTMLInputElement;
    if (input.name !== "ciclo" || !num || !cobranca) return;
    num.textContent = input.dataset.porMes ?? "";
    cobranca.textContent = input.dataset.cobranca ?? "";
  });

  // Botão de teste do modo privado, sincronizado com Alt+O.
  const botao = document.getElementById("btn-privado");
  const sincronizar = () => {
    const ligado = document.documentElement.hasAttribute("data-privado");
    botao?.setAttribute("aria-pressed", String(ligado));
    const texto = document.getElementById("btn-privado-texto");
    if (texto) texto.textContent = ligado ? "Desligar modo privado" : "Ligar modo privado";
  };
  botao?.addEventListener("click", () => {
    document.documentElement.toggleAttribute("data-privado");
    sincronizar();
  });
  document.addEventListener("privado", sincronizar);
</script>

<style>
  .secao {
    padding-block: var(--section);
  }
  .faixa {
    background: var(--ink-deep);
    padding-block: var(--section);
  }
  .bloco {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }
  .cabeca {
    display: grid;
    gap: 0.9rem;
    max-width: 40rem;
    align-content: start;
  }
  .titulo-largo {
    max-width: 45rem;
  }

  /* Topo */
  .hero {
    padding-top: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    padding-bottom: var(--section);
    overflow: hidden;
  }
  .hero-texto {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.5rem;
  }
  .hero-texto h1 {
    max-width: 14ch;
  }
  .hero-lede {
    max-width: 39rem;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .nota {
    font-size: 0.95rem;
    color: var(--text-soft);
  }

  /* Prints no topo: painel no computador e agenda do dia no celular */
  .hero-visual {
    position: relative;
    margin-top: clamp(2.5rem, 2rem + 3vw, 4rem);
    padding-right: clamp(3rem, 1rem + 9vw, 9rem);
  }
  .hero-visual :global(.hero-celular) {
    position: absolute;
    right: var(--gutter);
    bottom: -2.5rem;
    width: clamp(8.5rem, 5rem + 12vw, 15rem);
  }
  @media (max-width: 40rem) {
    .hero-visual {
      padding-right: 2.5rem;
    }
    .hero-visual :global(.hero-celular) {
      bottom: -1.5rem;
    }
  }

  /* Agenda: semana grande + cartão do detalhe da consulta */
  .arraste {
    display: none;
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-faint);
  }
  @media (max-width: 48rem) {
    .agenda-rolagem {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      border-radius: 16px;
    }
    .agenda-rolagem > :global(figure) {
      min-width: 46rem;
      box-shadow: none;
    }
    .arraste {
      display: block;
    }
  }
  .agenda-visual {
    position: relative;
  }
  .agenda-visual :global(.agenda-detalhe) {
    width: min(100%, 36rem);
    margin: 1.25rem 0 0 auto;
  }
  @media (min-width: 56rem) {
    .agenda-visual {
      padding-bottom: 4rem;
    }
    .agenda-visual :global(.agenda-detalhe) {
      position: absolute;
      right: -1rem;
      bottom: 0;
      margin: 0;
      box-shadow: 0 30px 70px -20px rgb(0 0 0 / 0.8);
    }
  }

  /* Modo privado: o print borrado aparece por cima quando o modo está ligado */
  .privado-imagens {
    position: relative;
  }
  .privado-imagens :global(.privado-borrado) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.25s;
  }
  :global(html[data-privado]) .privado-imagens :global(.privado-borrado) {
    opacity: 1;
  }

  /* Dores */
  .chat {
    display: grid;
    gap: 1.25rem 3rem;
    align-items: center;
  }
  @media (min-width: 48rem) {
    .chat {
      grid-template-columns: 1fr 1fr;
    }
  }
  .msg {
    justify-self: start;
    background: var(--ink-raise);
    border-radius: 22px 22px 22px 6px;
    padding: 1rem 1.25rem;
    font-size: 1.125rem;
    max-width: 29rem;
  }
  .resposta {
    display: grid;
    gap: 0.25rem;
  }
  .resposta b {
