---
import Janela from "./Janela.astro";
const campos = [
  ["Avaliação da demanda / objetivos", "Ansiedade antes de reuniões. Objetivo: participar das reuniões semanais sem evitar."],
  ["Procedimentos aplicados", "Revisão do registro de pensamentos. Ensaio da apresentação de sexta."],
  ["Resultados obtidos", "Participou de duas reuniões. Relata menos tensão antes de falar."],
  ["Encaminhamentos / decisões", "Manter o registro diário. Retomar o tema da chefia."],
];
---

<Janela
  compacta
  url="app.gradatim.com.br/pacientes/evolucoes"
  ativo="Pacientes"
  rotulo="Evolução de uma sessão no Gradatim, com os quatro campos do registro, com dados fictícios."
>
  <div class="m-main">
    <div class="m-paciente">
      <span class="m-avatar">MS</span>
      <div><div class="m-titulo" data-sensivel>Marina Souza</div><div class="m-peq">Sessão 14 · segunda, 12 de outubro</div></div>
    </div>
    <div class="m-evolucao">
      {campos.map(([t, v]) => <div class="m-campo"><b>{t}</b><div data-sensivel>{v}</div></div>)}
    </div>
    <div class="m-fim"><span class="m-btn">Prontuário (PDF)</span><span class="m-btn m-btn-p">Salvar evolução</span></div>
  </div>
</Janela>
