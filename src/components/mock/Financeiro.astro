---
import Janela from "./Janela.astro";
const linhas = [
  { nome: "Joana Martins", valor: "R$ 180", st: "Pago", c: "m-ok" },
  { nome: "Helena Prado", valor: "R$ 180", st: "Pendente", c: "m-pend" },
  { nome: "Marcos Vieira", valor: "R$ 360", st: "Atrasado", c: "m-atraso" },
];
const meses: [string, number][] = [
  ["mai", 56],
  ["jun", 63],
  ["jul", 60],
  ["ago", 72],
  ["set", 78],
  ["out", 88],
];
---

<Janela
  compacta
  url="app.gradatim.com.br/financeiro"
  ativo="Financeiro"
  rotulo="Financeiro do mês no Gradatim com o valor recebido, um gráfico por mês e pagamentos pago, pendente e atrasado, com dados fictícios."
>
  <div class="m-main">
    <div class="m-fin-topo">
      <div class="m-kpi">
        <span>Recebido em outubro</span>
        <b style="color:#166534" data-sensivel>R$ 6.840,00</b>
        <span class="m-peq" data-sensivel>R$ 900 a receber · R$ 360 atrasado</span>
      </div>
      <div class="m-barras m-barras-mini">
        <div>
          {
            meses.map(([m, h], i) => (
              <span class:list={{ atual: i === meses.length - 1 }}>
                <i style={`--h:${h}%`} />
                {m}
              </span>
            ))
          }
        </div>
      </div>
    </div>
    <div class="m-card m-lista-fin">
      {
        linhas.map((l) => (
          <div>
            <b data-sensivel>{l.nome}</b>
            <span data-sensivel>{l.valor}</span>
            <span class:list={["m-chip", l.c]}>{l.st}</span>
          </div>
        ))
      }
    </div>
  </div>
</Janela>
