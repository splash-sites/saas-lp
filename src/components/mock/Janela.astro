---
// Moldura de navegador + barra lateral do app. O conteúdo da tela entra no slot.
// `compacta`: recorte menor, sem barra lateral, para ficar ao lado de um texto.
interface Props {
  url: string;
  ativo: string;
  rotulo: string;
  compacta?: boolean;
}
const { url, ativo, rotulo, compacta = false } = Astro.props;
const itens = ["Painel", "Agenda", "Pacientes", "Lembretes", "Financeiro", "Assinatura", "Configurações"];
---

<div class:list={["m-janela", { "m-janela-compacta": compacta }]} role="img" aria-label={rotulo}>
  <div class="m-barra" aria-hidden="true">
    <span class="m-pontos"><i></i><i></i><i></i></span>
    <span class="m-url">{url}</span>
    <span class="m-aviso">Modo privado ligado</span>
  </div>
  <div class="m-corpo" aria-hidden="true">
    {
      !compacta && (
        <div class="m-lateral">
          <span class="m-logo">
            <svg width="24" height="24" viewBox="0 0 32 32"><circle cx="16" cy="16" r="16" fill="#F0B93B" /><path d="M8 23h5v-5h5v-5h5V9" fill="none" stroke="#12302B" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
            gradatim
          </span>
          <div class="m-nav">
            {itens.map((i) => <span class:list={{ ativo: i === ativo }}>{i}</span>)}
          </div>
        </div>
      )
    }
    <slot />
  </div>
</div>
