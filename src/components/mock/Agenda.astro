---
import Janela from "./Janela.astro";
const dias = ["Seg 12", "Ter 13", "Qua 14", "Qui 15", "Sex 16"];
const horas = ["08h", "09h", "10h", "11h", "12h", "13h", "14h", "15h", "16h"];
// col: 0..4 (seg..sex); lin: 0..8 (08h..16h)
const eventos = [
  { col: 0, lin: 1, nome: "Marina Souza", info: "Online", tipo: "online" },
  { col: 0, lin: 6, nome: "Paulo Reis", info: "Presencial", tipo: "presencial" },
  { col: 1, lin: 0, nome: "Joana Martins", info: "Presencial ✓", tipo: "presencial" },
  { col: 1, lin: 2, nome: "Caio Ferreira", info: "Online ✓", tipo: "online" },
  { col: 1, lin: 4, nome: "Almoço", info: "Bloqueado", tipo: "bloqueio" },
  { col: 1, lin: 7, nome: "Renata Alves", info: "Online", tipo: "online" },
  { col: 2, lin: 1, nome: "Marcos Vieira", info: "Faltou", tipo: "falta" },
  { col: 2, lin: 5, nome: "Helena Prado", info: "Online", tipo: "online" },
  { col: 3, lin: 2, nome: "Bruno Costa", info: "Presencial", tipo: "presencial" },
  { col: 3, lin: 6, nome: "Sofia Lima", info: "Online", tipo: "selecionada" },
  { col: 4, lin: 1, nome: "Teresa Gomes", info: "Presencial", tipo: "presencial" },
  { col: 4, lin: 3, nome: "Ana Barros", info: "Online", tipo: "online" },
];
---

<Janela
  url="app.gradatim.com.br/agenda"
  ativo="Agenda"
  rotulo="Agenda semanal do Gradatim com consultas online e presenciais, horário bloqueado, uma falta e o detalhe de uma consulta online com link do Google Meet, com dados fictícios."
>
  <div class="m-main">
    <div class="m-topo">
      <div class="m-acoes"><span class="m-titulo">12 a 16 de outubro</span><span class="m-btn">Hoje</span></div>
      <div class="m-acoes"><span class="m-btn">Bloquear horário</span><span class="m-btn m-btn-p">+ Nova consulta</span></div>
    </div>
    <div class="m-semana">
      {dias.map((d, i) => <span class:list={["dia", { hoje: i === 1 }]} style={`grid-column:${i + 2};grid-row:1`}>{d}</span>)}
      {horas.map((h, i) => <span class="hora" style={`grid-row:${i + 2}`}>{h}</span>)}
      {
        eventos.map((e) => (
          <div class:list={["m-ev", e.tipo]} style={`grid-column:${e.col + 2};grid-row:${e.lin + 2}`}>
            {e.tipo === "bloqueio" ? <b>{e.nome}</b> : <b data-sensivel>{e.nome}</b>}
            <span>{e.info}</span>
          </div>
        ))
      }
    </div>
  </div>
  <div class="m-detalhe">
    <div class="m-topo"><b style="font-size:18px" data-sensivel>Sofia Lima</b><span class="m-chip m-conf">Confirmada</span></div>
    <span class="m-sub">Quinta, 15 de outubro · 14:00 às 14:50</span>
    <div class="m-tags"><span class="m-tag teal">Online</span><span class="m-tag">Semanal</span></div>
    <div class="m-meet">
      <span class="m-peq" style="font-weight:600">Link do Google Meet</span>
      <span style="color:#0F766E;font-weight:600">meet.google.com/xyz-abcd-efg</span>
      <span class="m-btn m-btn-p">Copiar link</span>
    </div>
    <span class="m-sync">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
      Sincronizada com o Google
    </span>
    <div class="m-rodape-acoes"><span class="m-btn">Registrar evolução</span><span class="m-btn">Marcar falta</span></div>
  </div>
</Janela>
