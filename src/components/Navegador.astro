---
// Moldura de navegador em volta de um print real do app.
// A barra é desenhada aqui; o print entra recortado, só com a área de conteúdo.
interface Props {
  url: string;
  class?: string;
}
const { url, class: classe } = Astro.props;
---

<figure class:list={["navegador", classe]}>
  <div class="navegador-barra" aria-hidden="true">
    <span class="navegador-pontos"><i></i><i></i><i></i></span>
    <span class="navegador-url">{url}</span>
  </div>
  <div class="navegador-tela">
    <slot />
  </div>
</figure>

<style>
  .navegador {
    margin: 0;
    background: #f8fafc;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 40px 90px -40px rgb(0 0 0 / 0.75);
  }
  .navegador-barra {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: #eef2f1;
    border-bottom: 1px solid #e2e8f0;
  }
  .navegador-pontos {
    display: flex;
    gap: 6px;
    flex: none;
  }
  .navegador-pontos i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #cbd5e1;
  }
  .navegador-url {
    min-width: 0;
    background: #fff;
    border-radius: 999px;
    padding: 3px 12px;
    font-size: 12px;
    color: #475569;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .navegador-tela :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
