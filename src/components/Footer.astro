---
import Logo from "./Logo.astro";
import { APP_LOGIN_URL, WHATSAPP_EXIBICAO, WHATSAPP_URL } from "../consts";
const ano = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-inner">
    <Logo />
    <nav aria-label="Rodapé" class="footer-links">
      <a href={APP_LOGIN_URL}>Entrar</a>
      <a href="/#google-agenda">Uso do Google Agenda</a>
      <a href="/privacidade">Política de Privacidade</a>
      <a href="/termos">Termos de Uso</a>
      <a href={WHATSAPP_URL} rel="noopener" target="_blank">WhatsApp {WHATSAPP_EXIBICAO}</a>
    </nav>
    <span class="footer-copy">© {ano} Gradatim</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--ink-line);
    padding-block: 2rem 3rem;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2.5rem;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
  }
  .footer-links a {
    color: var(--text-link);
    font-size: 0.95rem;
    text-decoration: none;
  }
  .footer-links a:hover {
    color: var(--marigold);
    text-decoration: underline;
  }
  .footer-copy {
    margin-left: auto;
    font-size: 0.875rem;
    color: var(--text-faint);
  }
</style>
