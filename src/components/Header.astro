---
import Logo from "./Logo.astro";
import { APP_LOGIN_URL } from "../consts";
const naHome = Astro.url.pathname === "/";
const ancora = (id: string) => (naHome ? `#${id}` : `/#${id}`);
---

<header class="header">
  <div class="wrap header-inner">
    <a href="/" class="header-logo" aria-label="Gradatim, página inicial"><Logo /></a>
    <nav aria-label="Principal" class="header-nav">
      <a href={ancora("recursos")}>Recursos</a>
      <a href={ancora("seguranca")}>Segurança</a>
      <a href={ancora("preco")}>Preço</a>
      <a href={ancora("duvidas")}>Dúvidas</a>
    </nav>
    <div class="header-actions">
      <a href={APP_LOGIN_URL} class="header-entrar">Entrar</a>
      <a href={APP_LOGIN_URL} class="btn btn-primary header-cta">Teste grátis</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--ink) 86%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--ink-line) 70%, transparent);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 4.5rem;
  }
  .header-logo {
    text-decoration: none;
    margin-right: auto;
  }
  .header-nav {
    display: none;
    gap: 1.75rem;
  }
  .header-nav a {
    color: var(--text-link);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .header-entrar {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.5rem 0.25rem;
  }
  .header-nav a:hover,
  .header-entrar:hover {
    color: var(--marigold);
  }
  .header-cta {
    min-height: 2.75rem;
    padding: 0.6rem 1.15rem;
    font-size: 0.95rem;
    border-radius: 14px;
    white-space: nowrap;
  }
  @media (min-width: 60rem) {
    .header-nav {
      display: flex;
      margin-left: auto;
    }
    .header-logo {
      margin-right: 0;
    }
  }
</style>
