---
import Logo from "./Logo.astro";
import { APP_LOGIN_URL } from "../consts";
const naHome = Astro.url.pathname === "/";
const ancora = (id: string) => (naHome ? `#${id}` : `/#${id}`);
---

<header class="header">
  <div class="wrap header-inner">
    <a href="/" class="header-logo" aria-label="Gradatim, página inicial"><Logo /></a>
    <nav aria-label="Principal" class="header-nav">
      <a href={ancora("recursos")}>Recursos</a>
      <a href="/seguranca">Segurança</a>
      <a href={ancora("preco")}>Preço</a>
      <a href={ancora("duvidas")}>Dúvidas</a>
      <a href="/tutorial">Tutoriais</a>
    </nav>
    <div class="header-actions">
      <a href={APP_LOGIN_URL} class="btn header-cta header-entrar">Entrar</a>
      <a href={APP_LOGIN_URL} class="btn btn-primary header-cta">Teste grátis</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--ink) 86%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--ink-line) 70%, transparent);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 4.5rem;
  }
  .header-logo {
    text-decoration: none;
    margin-right: auto;
  }
  .header-nav {
    display: none;
    gap: 1.75rem;
  }
  .header-nav a {
    color: var(--text-link);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .header-nav a:hover {
    color: var(--marigold);
  }
  /* Entrar: mesmo formato do "Teste grátis", em teal (a cor do app) para não competir com o âmbar. */
  .header-entrar {
    background: var(--teal);
    color: var(--text);
  }
  .header-entrar:hover {
    background: #14897f;
    color: var(--text);
  }
  .header-cta {
    min-height: 2.75rem;
    padding: 0.6rem 1.15rem;
    font-size: 0.95rem;
    border-radius: 14px;
    white-space: nowrap;
  }
  /* Celular: logo nunca encolhe; os dois botões ficam mais justos para caber na margem. */
  .header-logo {
    flex-shrink: 0;
  }
  @media (max-width: 26rem) {
    .header-inner {
      gap: 0.75rem;
    }
    .header-actions {
      gap: 0.4rem;
    }
    .header-cta {
      padding-inline: 0.8rem;
      font-size: 0.9rem;
    }
  }
  @media (min-width: 60rem) {
    .header-nav {
      display: flex;
      margin-left: auto;
    }
    .header-logo {
      margin-right: 0;
    }
  }
</style>
